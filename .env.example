# Copy to .env and edit. All values have safe dev defaults.
NBO_SECRET_KEY=change-me-to-a-long-random-string

# Database — SQLite for local dev, Postgres for production.
# On Railway, the DATABASE_URL env var is auto-injected by the Postgres plugin;
# you do not need to set NBO_DATABASE_URL there.
NBO_DATABASE_URL=sqlite:///./data/nbo.db
# Postgres examples:
# NBO_DATABASE_URL=postgresql+psycopg://nbo:nbo@localhost:5432/nbo
# NBO_DATABASE_URL=postgresql://nbo:nbo@localhost:5432/nbo  (auto-rewritten)

NBO_DEBUG=true
NBO_DEFAULT_LOCALE=ru
NBO_SESSION_MAX_AGE=86400
# Number of proxy hops in front of the app. 0 = direct, 1 = one reverse proxy.
# Controls how far into X-Forwarded-For the real client IP is read.
NBO_TRUSTED_PROXY_HOPS=0
